RUN_COLLECTION_ON_STARTUP=false
NER_ENABLED=true
NER_MODEL_NAME=urchade/gliner_multi-v2.1
NER_DEVICE=cpu
NER_THRESHOLD=0.45
NER_TEXT_MAX_CHARS=1500
NER_BATCH_SIZE=1
NER_MAX_DOCUMENTS_PER_RUN=100
