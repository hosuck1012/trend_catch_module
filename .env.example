NEWSIS_RSS_TIMEOUT_SECONDS=15
SCHEDULER_ENABLED=false
COLLECTION_INTERVAL_HOURS=6
WEEKLY_CALCULATION_DAY=mon
WEEKLY_CALCULATION_HOUR=8
WEEKLY_CALCULATION_MINUTE=0
